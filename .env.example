# Copy to .env.local and fill in. Never commit real values.

# Public base URL used in links handed to Otto
ARKKO_BASE_URL=http://localhost:3000
# Signs file links and webhook bodies, and encrypts tokens stored in Airtable.
# Changing it makes existing Airtable requests unreadable.
ARKKO_SIGNING_SECRET=
# Bearer token Otto uses for /api/otto/*
OTTO_API_KEY=
# Optional: push new requests and notifications to Otto
OTTO_WEBHOOK_URL=
# Claude API key for the "Chat with Arkko" intake (https://console.anthropic.com).
# Without it, the chat option shows an error and people can use the form.
ANTHROPIC_API_KEY=

# Airtable storage (leave empty to use the local .data/ store)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
